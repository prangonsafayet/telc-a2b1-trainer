{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Emit is Vite's job. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Strictness: everything on, plus the checks `strict` leaves out. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client"],

    /* The test suites are plain JS that imports typed source. Including them here means
       every file in the repo belongs to a project — so the editor resolves the `@/`
       alias inside them — while checkJs keeps them out of the type-check itself. A
       composite project must list every file it touches, which is why they cannot live
       in a separate project that imports src. */
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tests", "e2e"]
}
