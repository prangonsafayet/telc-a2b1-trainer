# Copy this file to .env and fill in your own Supabase project values.
# Leave both empty (or delete .env) to run the trainer fully offline with localStorage only.
#
# Find these in Supabase → Project Settings → Data API:
#   VITE_SUPABASE_URL      the Project URL, exactly https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY the anon / publishable key (safe to ship to the browser; RLS protects the data)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute public URL of the deployed site. Used for canonical / Open Graph tags and the
# generated sitemap.xml + robots.txt. Netlify's own URL / DEPLOY_PRIME_URL is used if unset.
VITE_SITE_URL=

# OAuth providers to offer on the sign-in card. Only list ones you actually enabled in
# Supabase → Authentication → Providers. Supported here: google, github, azure, apple.
VITE_AUTH_PROVIDERS=google,github
