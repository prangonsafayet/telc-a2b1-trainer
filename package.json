{
  "name": "telc-a2b1-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "telc Deutsch A2\u00b7B1 mock exam trainer \u2014 10 full model tests, React + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node validate.cjs",
    "test": "npm run typecheck && npm run lint && npm run validate && npm run test:unit",
    "test:routes": "vite-node tests/routes.test.js",
    "test:flow": "vite-node tests/exam-flow.test.js",
    "test:auth": "vite-node tests/auth-visibility.test.js",
    "test:content": "vite-node tests/content-render.test.js",
    "test:date": "vite-node tests/exam-date.test.js",
    "test:unit": "npm run test:routes && npm run test:content && npm run test:auth && npm run test:signup && npm run test:date && npm run test:flow",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "images": "bash scripts/build-images.sh",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:signup": "vite-node tests/sign-up-outcome.test.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
